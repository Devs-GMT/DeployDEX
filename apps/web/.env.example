# Which BOT Chain network the site reads/writes: "mainnet" (677) or "testnet" (968)
NEXT_PUBLIC_CHAIN=testnet
# DeployDex registry addresses (single source of truth, see src/lib/config.ts)
NEXT_PUBLIC_REGISTRY_MAINNET=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REGISTRY_TESTNET=0x0000000000000000000000000000000000000000
# Server-only. Optional GitHub token to lift the 60 req/h limit on the /api/github proxy
GITHUB_TOKEN=
# Public site URL used for sitemap and social cards
NEXT_PUBLIC_SITE_URL=http://localhost:3000
